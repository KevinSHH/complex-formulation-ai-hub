# ComplexForm-AI Hub - 环境变量配置清单
# ===========================================
# 本文件列出所有需要配置的环境变量与 GitHub Secrets。
# 复制此文件为 .env（本地开发）或在 GitHub Settings -> Secrets 中逐条添加。

# ---------------------------------------------------------------------------
# 1. LLM API（用于 summarizer.py 结构化摘要增强）
#    支持任意 OpenAI 兼容 API。以下任选其一，推荐使用免费的 NVIDIA NIM。
# ---------------------------------------------------------------------------

# --- 选项 A（推荐·免费）: NVIDIA NIM ---
# 免费、无需信用卡，注册送额度（手机验证后更多），限速 40 RPM。
# 每日嗅探约 15 篇 × 2 次调用 = 30 次，远低于限速，完全够用。
# 获取 Key: https://build.nvidia.com -> 登录 -> 头像 -> API Keys -> Generate
# OPENAI_API_KEY=nvapi-your-nvidia-key
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=deepseek-ai/deepseek-v3.1
# 其他可选免费模型: qwen/qwen2.5-72b-instruct, meta/llama-3.3-70b-instruct,
#                  moonshotai/kimi-k2-instruct, mistralai/mistral-small-3.1-24b-instruct

# --- 选项 B: OpenAI 官方（付费） ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 选项 C: DeepSeek（便宜） ---
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_API_BASE=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# --- 选项 D: 方舟 Coding Plan ---
# OPENAI_API_KEY=ark-your-coding-key
# OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
# OPENAI_MODEL=ark-code-latest

# ---------------------------------------------------------------------------
# 2. PubMed API Key（可选，提高 E-utilities 速率限制：10 req/s -> 无限制）
#    申请地址: https://www.ncbi.nlm.nih.gov/account/settings/
# ---------------------------------------------------------------------------
PUBMED_API_KEY=

# ---------------------------------------------------------------------------
# 3. OpenAlex Polite Pool 邮箱（非敏感，仅用于进入高速通道 10 req/s）
#    默认值在 config.py 中已设置，可覆盖。
# ---------------------------------------------------------------------------
# OPENALEX_MAILTO=your-email@example.com

# ---------------------------------------------------------------------------
# 4. Hugging Face Token（用于触发 Space 重建 / 部署）
#    获取地址: https://huggingface.co/settings/tokens
#    权限: Write (需能 push 到 Space 仓库)
# ---------------------------------------------------------------------------
HF_TOKEN=hf-your-token-here

# ---------------------------------------------------------------------------
# 5. Hugging Face Space ID（GitHub Variable, 非 Secret）
#    格式: username/space-name  例如: complexform/complexform-ai-hub
#    在 GitHub Settings -> Settings -> Secrets and variables -> Actions
#    -> Variables 标签页中添加（不是 Secrets）
# ---------------------------------------------------------------------------
# HF_SPACE_ID=your-username/complexform-ai-hub

# ---------------------------------------------------------------------------
# 6. 本地文献库根目录覆盖（可选）
#    默认为项目上一级目录。若文献库在其他位置可覆盖。
# ---------------------------------------------------------------------------
# CFAH_LIBRARY_ROOT=/path/to/library

# ===========================================================================
# GitHub Secrets / Variables 配置对照表
# ===========================================================================
#
# | 名称               | 类型     | 必填 | 说明                          |
# |-------------------|----------|------|-------------------------------|
# | OPENAI_API_KEY    | Secret   | 否*  | LLM API Key                   |
# | OPENAI_API_BASE   | Secret   | 否   | LLM API Base URL              |
# | OPENAI_MODEL      | Secret   | 否   | 模型名                        |
# | PUBMED_API_KEY    | Secret   | 否   | PubMed 速率提升               |
# | HF_TOKEN          | Secret   | 否** | Hugging Face 部署 Token       |
# | HF_SPACE_ID       | Variable | 否** | HF Space 仓库 ID              |
#
# *  不设置时自动降级为纯规则抽取，功能正常但摘要质量降低。
# ** 不设置时跳过 HF Spaces 自动部署，可手动部署。
